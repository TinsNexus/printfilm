SECRET_KEY=dev-secret-change-me
# DEBUG=true 时应用日志更详细；SQL_ECHO=true 才打印原始 SQL（默认关，避免刷屏）
# DEBUG=true
# SQL_ECHO=false
# 本地默认 SQLite；正式可改为 Postgres（Docker 见 deploy/docker-compose.yml）
# DATABASE_URL=postgresql+asyncpg://printfilm:密码@127.0.0.1:5432/printfilm
# DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:密码@127.0.0.1:5432/printfilm
DATABASE_URL=sqlite+aiosqlite:///./ai_movie.db
DATABASE_URL_SYNC=sqlite:///./ai_movie.db
# Postgres 生产建议：API uvicorn --workers 1；Celery 设 PRINTFILM_DB_ROLE=celery
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_SIZE_CELERY=2
# DB_MAX_OVERFLOW_CELERY=3
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://192.168.110.88:5173
PUBLIC_BASE_URL=http://192.168.110.88:8000

# 启动时将已有账号提升为 admin（逗号分隔邮箱，不造号）
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
ARK_API_KEY=replace-me

# 文字模型 Kimi（OpenAI 兼容，对齐 manju；生图/视频仍走方舟 ARK_*）
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.moonshot.cn/v1
MODEL_LLM=kimi-k2.6

USE_CELERY=true
QUOTA_ENABLED=false

# Token 计费（用户价 = 成本 × markup）
BILLING_ENABLED=false
BILLING_MARKUP=1.5
BILLING_SIGNUP_GRANT_FEN=500
# 易支付 pay.gitcc.com（密钥勿提交）
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# 生产 notify 勿含 /api/（易支付 WAF 会拦截）；线上 nginx 反代 /epay/notify → /api/billing/epay/notify
# EPAY_NOTIFY_URL=https://kepu.printfilm.com/epay/notify
# EPAY_RETURN_URL=https://kepu.printfilm.com/pricing?paid=1

# Celery 动态扩缩容（python -m app.workers.autoscale）
# Windows 下每个 worker 为 solo×1，按队列积压自动加减进程数
CELERY_AUTOSCALE_MIN=1
CELERY_AUTOSCALE_MAX=3
CELERY_AUTOSCALE_POLL_SEC=5
CELERY_AUTOSCALE_IDLE_SEC=45
CELERY_AUTOSCALE_QUEUE=pipeline
# Worker 监听队列（逗号分隔；drama 优先，避免漫剧 LLM 被 pipeline 成片堵住）
CELERY_WORKER_QUEUES=drama,oss,video,pipeline
# 防僵死：任务超时 + Redis 可见性超时（需 > time_limit）+ 进度停滞自动重派
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2100
CELERY_VISIBILITY_TIMEOUT=2400
CELERY_STALE_PROJECT_SEC=900

# 旗舰模型（需在方舟控制台开通；若账号仅支持接入点，可改为 ep-xxxxxxxx）
# 文字模型见上方 OPENAI_* / MODEL_LLM；以下为 Seedream/Seedance/TTS
MODEL_IMAGE=doubao-seedream-5-0-260128
# Seedream 4.5 接入点（可选；未配则回退 MODEL_IMAGE）
# MODEL_IMAGE_45=ep-xxxxxxxx
MODEL_VIDEO=doubao-seedance-2-5-260628
SEEDANCE_DURATION_MIN=4
SEEDANCE_DURATION_MAX=30
# 已废弃：科普成片走外部 TTS，不再直出口播（管线忽略此开关）
KEPU_SEEDANCE_GENERATE_AUDIO=false
# 科普 Seedance 仍出音轨：只要键盘/点击等操作环境音，不要口播与 BGM
KEPU_SEEDANCE_SFX_AUDIO=true
MODEL_AUDIO=seed-tts-2.0

# 豆包语音合成（openspeech，与方舟 Key 不同）。不配则自动用 edge-tts 兜底
# 新版控制台 API Key（ai-manju 项目里同名 SPEECH_API_KEY）
# VOLC_TTS_API_KEY=
# 旧版控制台（可选回退）
# VOLC_TTS_APP_ID=
# VOLC_TTS_ACCESS_KEY=
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
# 漫剧角色音色设计（需控制台购买 S_ 槽位）：https://docs.volcengine.com/docs/6561/2277844
# VOLC_TTS_VOICE_DESIGN_SPEAKER_IDS=S_xxx,S_yyy
# VOLC_TTS_VOICE_DESIGN_URL=https://openspeech.bytedance.com/api/v3/tts/voice_design

ARK_IMAGE_SIZE=2k
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_RATIO=16:9
ARK_VIDEO_POLL_INTERVAL=8
ARK_VIDEO_POLL_TIMEOUT=900
PIPELINE_IMAGE_CONCURRENCY=3
PIPELINE_VIDEO_CONCURRENCY=10
PIPELINE_AUDIO_CONCURRENCY=4

# Aliyun OSS（成片/分镜上传；FFmpeg 仍用本地文件。前端 dist 见 deploy/scripts/upload_oss_web.py）
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_FOLDER=kepu
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
# OSS_PUBLIC_BASE=https://cdn.example.com
