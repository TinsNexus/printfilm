# ── /opt/ai_movie 专用 Postgres + Redis（勿与 kepu 共用）────────
POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm
POSTGRES_PORT=15432
REDIS_PORT=16379

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
REDIS_URL=redis://127.0.0.1:16379/0

PUBLIC_BASE_URL=https://kepu.printfilm.com
CORS_ORIGINS=https://kepu.printfilm.com
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
ARK_API_KEY=your-ark-api-key
USE_CELERY=true
QUOTA_ENABLED=false

BILLING_ENABLED=true
BILLING_MARKUP=1.5
BILLING_SIGNUP_GRANT_FEN=500
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=https://kepu.printfilm.com/api/billing/epay/notify
EPAY_RETURN_URL=https://kepu.printfilm.com/pricing?paid=1

CELERY_AUTOSCALE_MIN=1
CELERY_AUTOSCALE_MAX=3
