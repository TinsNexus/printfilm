# Docker 全栈环境变量（复制为 deploy/.env.docker 后修改）
# 用法：docker compose --env-file deploy/.env.docker -f docker-compose.yml up -d

POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm

SECRET_KEY=change-me-to-a-long-random-string

# 用户端 nginx :8080；管理端 :8081；API 文档 :8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8080

# 启动后将已注册邮箱提权为管理员（逗号分隔，不造号）
# ADMIN_BOOTSTRAP_EMAILS=you@example.com

ARK_MOCK=false
# TokenFree New API（文字 / 生图 / 生视频同一把 Key；也可在管理后台「系统设置 → 模型」填写）
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://www.tokenfree.com/v1
ARK_API_KEY=replace-me
MODEL_LLM=kimi-k2.6
MODEL_IMAGE=doubao-seedream-5-0-260128
MODEL_VIDEO=doubao-seedance-2-5-260628

BILLING_ENABLED=false
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
BILLING_USD_CNY=7.0

OSS_ENABLED=false
